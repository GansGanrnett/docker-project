# Шаблон конфигурации окружения. Скопируйте в .env и укажите СВОИ значения.

# === База данных аутентификации (PostgreSQL) ===
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=<сгенерируйте-надёжный-пароль>
AUTH_DB_NAME=auth_db
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=<сгенерируйте-надёжный-пароль>

# === База данных каталога (PostgreSQL) ===
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=<сгенерируйте-надёжный-пароль>
CATALOG_DB_NAME=catalog_db

# === База данных заказов (MongoDB) ===
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=<сгенерируйте-надёжный-пароль>

# === Кэш корзины (Redis) ===
REDIS_PASSWORD=<сгенерируйте-надёжный-пароль>

# === Брокер сообщений (RabbitMQ) ===
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=<сгенерируйте-надёжный-пароль>
RABBITMQ_MANAGEMENT_PORT=15672

# === Порты сервисов (внутренняя сеть; наружу слушают только на 127.0.0.1) ===
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
CART_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085

# === Мониторинг ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<сгенерируйте-надёжный-пароль>